rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isConversationParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    // ===============================================================
    // 1. USERS COLLECTION
    // ===============================================================
    // Stores user profiles (name, email, emailLower, preferredLanguage, accessibility settings)
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for searching friends by email)
      allow read: if isAuthenticated();

      // Only the user themselves can create or update their own profile document
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // 2. CONVERSATIONS COLLECTION
    // ===============================================================
    // Stores conversation metadata between two users
    match /conversations/{conversationId} {
      // Participants can read the conversation
      allow read: if isAuthenticated() && (
        resource == null || request.auth.uid in resource.data.participants
      );

      // Authenticated users can create a conversation if they are listed in participants
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );

      // Only participants can update conversation metadata (e.g., lastMessage, updatedAt)
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );

      // Deleting conversations is restricted to participants
      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );

      // -------------------------------------------------------------
      // 2a. MESSAGES SUBCOLLECTION
      // -------------------------------------------------------------
      // Stores individual messages (text, speech, sign)
      match /messages/{messageId} {
        // Read allowed if the user is a participant of the parent conversation
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );

        // Create allowed if sender is authenticated and is a participant
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Messages are immutable once sent
        allow update: if false;
        allow delete: if false;
      }
    }

    // ===============================================================
    // 3. FRIEND REQUESTS COLLECTION
    // ===============================================================
    // Handles sending, accepting, and declining friend requests
    match /friendRequests/{requestId} {
      // Either sender or receiver can view the request
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      // Sender can create a friend request
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid &&
        request.resource.data.status == "pending";

      // Receiver can accept or decline; Sender can cancel
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );

      // Allowed to delete completed/declined requests
      allow delete: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }

    // ===============================================================
    // 4. CONTACTS COLLECTION
    // ===============================================================
    // Stores saved personal contacts per user
    match /contacts/{userId} {
      allow read, write: if isOwner(userId);

      match /items/{contactId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}

